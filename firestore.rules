rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable Helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isEmailVerified() && getUserData().role == role; }
    function isAdmin() { return hasRole('ADMIN') || hasRole('MD'); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isEmailVerified() && request.auth.uid == userId && (
        // Admin bootstrap
        (request.auth.token.email in ['adeagbojohnluj@gmail.com', 'admin@ysjpoultry.com'] && request.resource.data.role == 'ADMIN') ||
        // Support Invitation system
        (exists(/databases/$(database)/documents/authorizedStaff/$(request.auth.token.email)) && 
         request.resource.data.role == get(/databases/$(database)/documents/authorizedStaff/$(request.auth.token.email)).data.role) ||
        // Fallback for staff registration if no role specified, or force STAFF
        (request.resource.data.role == 'STAFF')
      );
      
      allow update: if (isAdmin() || (isEmailVerified() && request.auth.uid == userId)) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'email'])
      ) && (
        (isAdmin()) || (request.resource.data.role == resource.data.role)
      );
    }

    match /authorizedStaff/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow write: if isAdmin();
    }

    // 2. Bird Batches
    match /birdBatches/{batchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidBatch(request.resource.data);
      allow update: if (isAdmin() || hasRole('MANAGER')) && isValidBatch(request.resource.data) && (
        // Action: Update Progress/Audit
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'feedStock', 'status', 'updatedAt']) ||
        // Action: Full Edit
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'type', 'arrivalDate', 'expectedHarvest', 'feedStock', 'status', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // 2.1 Daily Reports
    match /dailyReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || hasRole('MANAGER')) && isValidDailyReport(request.resource.data);
      allow update: if (isAdmin() || hasRole('MANAGER')) && isValidDailyReport(request.resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mortality', 'feedUsed', 'notes', 'date', 'updatedAt', 'updatedBy'])
      );
      allow delete: if isAdmin();
    }

    // 3. Sales
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidSale(request.resource.data);
      allow update: if isAdmin() && isValidSale(request.resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'status', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // 4. Comments
    match /comments/{commentId} {
      allow read: if isSignedIn();
      // Anyone signed in can comment
      allow create: if isSignedIn() && isValidComment(request.resource.data) && request.resource.data.authorId == request.auth.uid;
      // Authors can update their own comments text
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
      ) && isValidComment(request.resource.data);
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Validation Blueprints
    function isValidBatch(data) {
      return data.keys().hasAll(['count', 'type', 'status']) &&
             data.count is number && data.count >= 0 &&
             (data.get('feedStock', 0) is number) &&
             data.type is string &&
             data.status in ['Growing', 'Ready', 'Harvested'];
    }

    function isValidDailyReport(data) {
      return data.keys().hasAll(['batchId', 'date', 'mortality', 'feedUsed']) &&
             data.batchId is string && 
             data.mortality is number && data.mortality >= 0 &&
             data.feedUsed is number && data.feedUsed >= 0;
    }

    function isValidSale(data) {
      return data.keys().hasAll(['amount', 'status', 'customer', 'date']) &&
             data.amount is number && data.amount >= 0 &&
             data.status in ['Paid', 'Pending'] &&
             data.customer is string && data.customer.size() <= 200;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['text', 'authorId', 'entityId', 'createdAt']) &&
             data.text is string && data.text.size() <= 1000 &&
             data.authorId == request.auth.uid &&
             exists(/databases/$(database)/documents/birdBatches/$(data.entityId)) || exists(/databases/$(database)/documents/sales/$(data.entityId));
    }
  }
}
